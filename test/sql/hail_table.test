# name: test/sql/hail_table.test
# description: HailTable (.ht) scanner integration tests
# group: [sql]

require quack

require-env HAILING_DUCKS_ROOT

# --- Row count and flat scalar field ---

query I
SELECT COUNT(*) FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture.ht');
----
3

query I
SELECT idx FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture.ht') ORDER BY idx;
----
0
1
2

# --- Nested fields not yet decoded: present in schema, NULL at scan time ---

query I
SELECT locus IS NULL FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture.ht') ORDER BY idx;
----
true
true
true

query I
SELECT alleles IS NULL FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture.ht') ORDER BY idx;
----
true
true
true

# --- Optional top-level field: row struct's own missing-bit prefix must be
# read before decoding its fields (regression test for task-3 fix Important
# #2 -- see hailtable_fixture_optional.ht, whose 'qual' field is optional at
# the top level, unlike the main fixture where every field is required) ---

query II
SELECT idx, qual FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture_optional.ht') ORDER BY idx;
----
0	1.500000
1	NULL
2	3.250000

# --- Error: path does not contain rows/metadata.json.gz ---

statement error
SELECT * FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/no_such.ht');
----
Cannot open Hail table metadata

# --- LZ4HC codec fallback: same row count and scalar values as Zstd ---

query I
SELECT COUNT(*) FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture_lz4hc.ht');
----
3

query I
SELECT idx FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture_lz4hc.ht') ORDER BY idx;
----
0
1
2

# --- LZ4Fast codec fallback: same row count and scalar values as Zstd ---

query I
SELECT COUNT(*) FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture_lz4fast.ht');
----
3

query I
SELECT idx FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture_lz4fast.ht') ORDER BY idx;
----
0
1
2

# --- Unknown codec name in the nested _bufferSpec chain fails at bind time ---

statement error
SELECT * FROM hail_scan_table('${HAILING_DUCKS_ROOT}/test/hailtable_fixture_bad_codec.ht');
----
Unknown Hail codec

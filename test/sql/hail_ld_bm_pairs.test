# name: test/sql/hail_ld_bm_pairs.test
# group: [sql]

require quack

# hail_ld_bm_pairs(bm_path, resolved): generates strict canonical off-diagonal pairs (idx_i < idx_j)
# among already-HT-resolved (idx, allele_order) variants for one locus, reads each touched block once,
# sign-corrects with allele_order_i * allele_order_j, and reports BM status separately from HT status.
#
# Tile selection: real s3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.bm data confirmed the tile
# (block_row, block_col) to open is (idx_j's band, idx_i's band) -- i.e. block_row >= block_col,
# lower-triangle-inclusive at the tile level. But WITHIN a selected tile, the array offset is the
# opposite of what tile selection alone would suggest: the row axis holds idx_i's (the smaller
# canonical index) own local offset, and the col axis holds idx_j's (the larger) own local offset --
# verified against two real blocks (one diagonal, one off-diagonal) fetched and manually decoded
# against an independent Hail-computed LD reference.
#
# Fixture test/matrix_ld.bm: 6x6 matrix, blockSize=2 (3x3 grid of 2x2 blocks, flat index =
# block_row*3+block_col). Tiles stored: 0,3,4,7,8; tile 6 (rows4-5,cols0-1) is deliberately missing to
# test bm_missing_block. One cell within tile 3 is NaN to test bm_missing_or_nan. See
# scripts/generate_blockmatrix_fixture.py's BLOCK_VALUES for the exact per-tile array contents.
# Resolved indices given out of order on purpose, to prove canonicalization doesn't depend on input
# order; idx=7 is out of the matrix's 0..5 range to test bm_index_out_of_bounds.
query IIRTI
SELECT idx_i, idx_j, r, bm_status_domain, bm_status_code
FROM hail_ld_bm_pairs('test/matrix_ld.bm', [
  {'idx': 4::BIGINT, 'allele_order': -1},
  {'idx': 0::BIGINT, 'allele_order': 1},
  {'idx': 7::BIGINT, 'allele_order': 1},
  {'idx': 1::BIGINT, 'allele_order': -1},
  {'idx': 3::BIGINT, 'allele_order': 1}
])
ORDER BY idx_i, idx_j;
----
0	1	-1.0	bm	0
0	3	21.0	bm	0
0	4	NULL	bm	3
0	7	NULL	bm	2
1	3	NULL	bm	4
1	4	NULL	bm	3
1	7	NULL	bm	2
3	4	-52.0	bm	0
3	7	NULL	bm	2
4	7	NULL	bm	2

# A single resolved variant has no pairs to form -> zero rows.
query I
SELECT COUNT(*) FROM hail_ld_bm_pairs('test/matrix_ld.bm', [{'idx': 0::BIGINT, 'allele_order': 1}]);
----
0

# An empty resolved list -> zero rows.
query I
SELECT COUNT(*) FROM hail_ld_bm_pairs('test/matrix_ld.bm', CAST([] AS STRUCT(idx BIGINT, allele_order INTEGER)[]));
----
0

# Integration: compose with real hail_ld_resolve_ht output (issue #18) rather than a hand-built
# literal -- table function arguments can't contain subqueries directly, so materialize the resolved
# list through a session variable, matching how a real query would chain the two stages for one locus.
require parquet

statement ok
COPY (
  SELECT * FROM (VALUES
    ('locus1', 'chr1:100-500', ['chr1_200_A_G', 'chr1_300_A_G'])
  ) AS t(locus_id, locus, variant_ids)
) TO '__TEST_DIR__/hail_ld_bm_pairs_requests.parquet' (FORMAT PARQUET);

statement ok
SET VARIABLE resolved = (
  SELECT list({'idx': idx, 'allele_order': allele_order})
  FROM hail_ld_resolve_ht('test/hailtable_fixture_ld.ht', '__TEST_DIR__/hail_ld_bm_pairs_requests.parquet')
  WHERE locus_id = 'locus1' AND status_code IN (0, 1)
);

query IIR
SELECT idx_i, idx_j, r FROM hail_ld_bm_pairs('test/matrix_ld.bm', getvariable('resolved'));
----
1	2	-30.0

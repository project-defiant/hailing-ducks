require quack

# Edge cases for hail_ld_preflight

# 1) Empty input should return zero rows
query I
SELECT COUNT(*) FROM hail_ld_preflight('');
----
0

# 2) Malformed request (not 3 parts) should return zero rows
query I
SELECT COUNT(*) FROM hail_ld_preflight('badformat');
----
0

# 3) Unsupported variant id returns code 5
query III
SELECT locus_id, requested_variant_id, status_code
FROM hail_ld_preflight('locusX|chr1:1-10|not_a_variant')
LIMIT 1;
----
locusX	not_a_variant	5

# 4) Deduping: duplicate variants are emitted once
query III
SELECT locus_id, requested_variant_id, status_code
FROM hail_ld_preflight('locus1|chr1:1000-2000|chr1_1001_A_G,chr1_1002_C_T,chr1_1001_A_G')
ORDER BY requested_variant_id;
----
locus1	chr1_1001_A_G	0
locus1	chr1_1002_C_T	0


# name: test/sql/hail_ld_ht_partitions.test
# group: [sql]

require quack

# hail_ld_ht_partitions_for_locus proves partition pruning uses the HT's own _jRangeBounds, without
# exposing internal C++ structures: it reports which partition indices a locus range would select
# against test/hailtable_fixture_ld.ht (3 partitions: 0 = chr1 150-400, 1 = chr1 700-800, 2 = chr2 200-200).

# A narrow chr1 sub-range touching only partition 0's span selects just partition 0.
query I
SELECT partition_idx FROM hail_ld_ht_partitions_for_locus('test/hailtable_fixture_ld.ht', 'chr1:150-250')
ORDER BY partition_idx;
----
0

# A chr1 range spanning both chr1 partitions selects 0 and 1, never partition 2 (chr2).
query I
SELECT partition_idx FROM hail_ld_ht_partitions_for_locus('test/hailtable_fixture_ld.ht', 'chr1:100-1000')
ORDER BY partition_idx;
----
0
1

# A chr1 range that only overlaps partition 1's span selects partition 1 only.
query I
SELECT partition_idx FROM hail_ld_ht_partitions_for_locus('test/hailtable_fixture_ld.ht', 'chr1:600-1000')
ORDER BY partition_idx;
----
1

# chr2 selects only partition 2.
query I
SELECT partition_idx FROM hail_ld_ht_partitions_for_locus('test/hailtable_fixture_ld.ht', 'chr2:1-1000')
ORDER BY partition_idx;
----
2

# A contig that never appears in the table selects nothing.
query I
SELECT partition_idx FROM hail_ld_ht_partitions_for_locus('test/hailtable_fixture_ld.ht', 'chr3:1-10')
ORDER BY partition_idx;
----

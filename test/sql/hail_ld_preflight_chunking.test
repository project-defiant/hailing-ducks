require quack

# Chunking tests with CHUNK_SIZE=16 (in-extension test override)

# 0 items
query I
SELECT requested_variant_id FROM hail_ld_preflight('locusC|1:1-10| ')
ORDER BY requested_variant_id;
----

# 1 item
query I
SELECT requested_variant_id FROM hail_ld_preflight('locusC|1:1-10| chr1_1_A_T ')
ORDER BY requested_variant_id;
----
chr1_1_A_T

